#!/bin/bash
#SBATCH --account=curso04
#SBATCH --nodes=1       # numero de nodos (maximo 10)
#SBATCH --job-name=clasificacion_aves # nombre del job
#SBATCH --ntasks=1      # <----- número de procesos que se requieran
#SBATCH --time=12:00:00  # tiempo de ejecucion (maximo 168 hrs)
#SBATCH --partition=gpu # solo hay una cola, asi que puede omitirse

#echo "Clasificando pinguinos" # <--- opcional
source activate aves
python clasificacion_aves.py
